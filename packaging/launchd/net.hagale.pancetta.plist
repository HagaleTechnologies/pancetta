<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd agent for running pancetta as an unattended FT8 station on macOS.
  KeepAlive restarts pancetta automatically if it exits or crashes (including a
  native ft8_lib C abort that no Rust panic handler can catch).

  Install (per-user LaunchAgent), run from the repository root:
    mkdir -p "$HOME/Library/LaunchAgents" "$HOME/.pancetta/logs"
    cp packaging/launchd/net.hagale.pancetta.plist "$HOME/Library/LaunchAgents/"
    # Edit the installed copy before loading it:
    # set ProgramArguments[0] to the absolute path of your pancetta binary;
    # replace /Users/YOURNAME in BOTH log paths with your absolute home directory.
    # Use the actual path, not ~ or $HOME inside the plist.
    "${EDITOR:-vi}" "$HOME/Library/LaunchAgents/net.hagale.pancetta.plist"
    plutil -lint "$HOME/Library/LaunchAgents/net.hagale.pancetta.plist"
    launchctl load -w "$HOME/Library/LaunchAgents/net.hagale.pancetta.plist"
    # logs: tail -f "$HOME/.pancetta/logs/launchd.out.log" "$HOME/.pancetta/logs/launchd.err.log"
    # stop: launchctl unload "$HOME/Library/LaunchAgents/net.hagale.pancetta.plist"

  Upgrading an existing installation: launchctl unload the agent first (during a
  safe idle interval), repeat the install sequence above, and reapply your
  binary-path customization to the new copy. Old /tmp/pancetta.launchd.*.log
  files are not moved automatically; copy them out if you still need them.
  The log files above live in your home directory, so they survive a reboot;
  a per-user LaunchAgent resumes after user login following a reboot. These two
  supervisor files are not rotated.

  Pancetta runs headless under a supervisor (no TUI).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>net.hagale.pancetta</string>
    <key>ProgramArguments</key>
    <array>
        <!-- Adjust to your installed binary path. -->
        <string>/usr/local/bin/pancetta</string>
        <string>--headless</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart on any exit, throttled so a crash-loop can't spin. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/Users/YOURNAME/.pancetta/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/YOURNAME/.pancetta/logs/launchd.err.log</string>
</dict>
</plist>
