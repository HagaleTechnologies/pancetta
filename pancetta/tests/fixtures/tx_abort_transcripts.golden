# TX-worker abort transcripts (PAN-322). One block per cell:
# [Shape/Phase/Reason], then `pre|post <channel> <event>` for every
# message the worker sent, relative to the abort action. Channels go
# in the order hamlib, autonomous, qso, tui, audio; each keeps its
# arrival order. Re-bless with:
#   PANCETTA_BLESS_TX_ABORT=1 cargo test -p pancetta --lib coordinator::tx::abort_transcripts

[Single/PrePtt/Shutdown]
pre qso TxFrameScheduled(qso-a, TxAttemptId(7))
pre tui TxQueueStatus(sending=None, queued=[("K1ABC W9XYZ FN20", 1500.0, false)])
pre tui TxQueueStatus(sending=None, queued=[("K1ABC W9XYZ FN20", 1500.0, true)])

[Single/PrePtt/Operator]
post autonomous TransmitComplete(success=false, Some("qso-a"), Some(TxAttemptId(7)), 'K1ABC W9XYZ FN20')
pre qso TxFrameScheduled(qso-a, TxAttemptId(7))
post qso TxFrameNotSent(qso-a, 'K1ABC W9XYZ FN20', Some(TxAttemptId(7)), replaced=false)
pre tui TxQueueStatus(sending=None, queued=[("K1ABC W9XYZ FN20", 1500.0, false)])
pre tui TxQueueStatus(sending=None, queued=[("K1ABC W9XYZ FN20", 1500.0, true)])
post tui TxQueueStatus(sending=None, queued=[])

